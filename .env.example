# Copia este archivo como `.env` en la raíz del repositorio (Git lo ignora) y rellena los valores.
# Las variables ya definidas en el entorno tienen prioridad sobre este archivo.
# No pongas secretos reales en `.env.example`.

# --- Django ---
# Obligatoria si DJANGO_DEBUG es falso. Genera una con:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# true en local (por defecto); false fuera de desarrollo.
DJANGO_DEBUG=true
# Lista separada por comas; vacía en local con DEBUG.
DJANGO_ALLOWED_HOSTS=
# Orígenes adicionales para CSRF (p. ej. https://observatorio.example.org); vacía en local.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cookies solo por HTTPS; por defecto activo cuando DEBUG es falso.
# DJANGO_SECURE_COOKIES=true

# --- Flujo de agentes (docs/api/CONTRATO_USUARIOS_INGESTA.md §3) ---
# Sin clave, los envíos fallan con un mensaje claro; las pruebas nunca llaman a OpenAI.
OPENAI_API_KEY=
# Modelo de razonamiento para extracción, verificación y análisis (configurable).
OPENAI_MODEL=gpt-5-mini
# Modelo compatible con la herramienta de búsqueda web de la API Responses (configurable).
OPENAI_SEARCH_MODEL=gpt-5-mini
INGESTION_MAX_RELATED=5
INGESTION_DAILY_LIMIT=10
INGESTION_AUTO_PUBLISH=false
INGESTION_USER_AGENT=GeoObservatorio/0.1 (+local-dev)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
